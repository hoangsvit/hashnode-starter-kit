	"version": "2.0.0",
	"tasks": [
		{
			"label": "pnpm install",
			"type": "shell",
			"command": "pnpm install --frozen-lockfile",
			"group": "none",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"group": "one"
			}
		},
		{
			"label": "eplus",
			"type": "shell",
			"command": "pnpm dev",
			"group": "none",
			"options": {
				"cwd": "${workspaceFolder}/packages/blog-starter-kit/themes/eplus"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"group": "one"
			},
			"runOptions": {
				"runOn": "folderOpen"
			}
		},
		{
			"label": "eplus - build",
			"type": "shell",
			"command": "pnpm build",
			"group": "none",
			"options": {
				"cwd": "${workspaceFolder}/packages/blog-starter-kit/themes/eplus"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"group": "one"
			}
		},
		{
			"label": "hashnode",
