			"type": "shell",
			"command": "pnpm dev",
			"group": "none",
			"options": {
				"cwd": "${workspaceFolder}/packages/blog-starter-kit/themes/enterprise"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"group": "one"
			}
		},
		{
			"label": "personal",
			"type": "shell",
			"command": "pnpm dev",
			"group": "none",
			"options": {
				"cwd": "${workspaceFolder}/packages/blog-starter-kit/themes/personal"
