NEXT_PUBLIC_HASHNODE_GQL_ENDPOINT=https://gql.hashnode.com
NEXT_PUBLIC_HASHNODE_PUBLICATION_HOST=engineering.hashnode.com
NEXT_PUBLIC_MODE=development

# Google Analytics Configuration
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Enable Google Analytics in development mode (optional)
# Set to 'true' to track events in development environment
NEXT_PUBLIC_GA_DEV_MODE=false

# Image Blur Mode for Privacy (Optional)
# Set to 'true' to blur all images for privacy protection
# Default: false (images are not blurred)
NEXT_PUBLIC_BLUR_IMAGES=false